# Example initial reverse zone file for 172.x.x.x networks
# This will be auto-generated by infradmin, but serves as a template

$TTL 300
@       IN  SOA ns1.local.dev. admin.local.dev. (
                1           ; Serial (will be auto-updated)
                3600        ; Refresh
                1800        ; Retry
                604800      ; Expire
                300         ; Minimum TTL
                )

        IN  NS  ns1.local.dev.
        IN  NS  ns2.local.dev.

; Container PTR records will be auto-generated here by infradmin
